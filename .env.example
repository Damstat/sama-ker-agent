# Modèle
GOOGLE_API_KEY=remplacer-par-votre-cle
MODEL_NAME=gemini-3.1-flash-lite
MAX_STEPS=15

# Google OAuth (fichiers locaux, jamais commités)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Agendas des conseillers (IDs d'agenda Google)
CALENDAR_ID_CONSEILLER_2=xxxx@group.calendar.google.com
CALENDAR_ID_CONSEILLER_1=xxxx@group.calendar.google.com
CALENDAR_ID_CONSEILLER_3=xxxx@group.calendar.google.com
TIMEZONE=Africa/Dakar

# Catalogue
DB_PATH=data/catalogue.db
MCP_TRANSPORT=stdio
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

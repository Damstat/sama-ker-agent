# Modèle
GOOGLE_API_KEY=remplacer-par-votre-cle
MODEL_NAME=gemini-2.5-flash
MAX_STEPS=15

# Google OAuth (fichiers locaux, jamais commités)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Agendas des conseillers (IDs d'agenda Google)
CALENDAR_ID_CONSEILLER_Fatou=xxxx@group.calendar.google.com
CALENDAR_ID_CONSEILLER_Moussa=xxxx@group.calendar.google.com
CALENDAR_ID_CONSEILLER_Ibrahima=xxxx@group.calendar.google.com
TIMEZONE=Africa/Dakar

# Catalogue
DB_PATH=data/catalogue.db
MCP_SERVER_URL=http://localhost:8000/mcp
